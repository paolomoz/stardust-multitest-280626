    {
      "role": "section",
      "tag": "div",
      "cls": "text-neutral-base light   w-full",
      "innerText": "Xfinity Accessibility and Inclusive Design Possible. Powerful. Personal. We connect all people to more of what they love. Because a disability isn’t the lack of ability. It’s the lack of a solution.",
      "bg": "rgba(0, 0, 0, 0)",
      "color": "rgb(0, 0, 0)",
      "headings": [
        "Xfinity Accessibility and Inclusive Design",
        "Possible. Powerful. Personal."
      ]
    },
    {
      "role": "section",
      "tag": "div",
      "cls": "text-neutral-base light   w-full theme-pad-24b",
      "innerText": "",
      "bg": "rgba(0, 0, 0, 0)",
